# Deployment configuration for Fairy Chess. Copy this to `.env` and edit it.
#
# The `VITE_` entries are for the site: Vite loads this file when it builds and
# inlines them into the bundle. The rest are for the matchmaking server, which
# `deno task start` in `matchmaking/` loads from the same file. Anything already
# in the real environment wins over the file, so a service manager can override
# a value without editing it.

# --- The matchmaking server (matchmaking/main.ts) ---

# The address and port to listen on. Bind to localhost when a proxy in front
# terminates TLS for you.
HOST=0.0.0.0
PORT=8000

# The origins allowed to open a matchmaking socket, comma separated, e.g.
# https://fairy-chess.com,https://www.fairy-chess.com,http://localhost:5173
# An empty value allows every origin and logs a warning, which is only safe in
# development.
ALLOWED_ORIGINS=http://localhost:5173

# How often to send a keepalive, in milliseconds. Zero disables it.
# HEARTBEAT_MS=30000

# The largest message accepted from a client, in UTF-16 code units.
# MAX_MESSAGE_BYTES=8192

# --- The site (src/online/config.ts) ---

# Where the browser should look for the matchmaking server. Left unset, a
# development build uses ws://localhost:8000/ws and a production build uses
# wss://fairy-chess-matchmaking.mousetail.nl/ws.
VITE_MATCHMAKING_URL=ws://localhost:8000/ws

# Persistence. The games in progress are kept in Redis under their UUID; players,
# finished games and their ratings are kept in PostgreSQL. Leave both blank to
# keep everything in memory, as a checkout does.
REDIS_URL=
DATABASE_URL=
