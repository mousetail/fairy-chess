{
  "name": "fairy-chess-matchmaking",
  "version": "0.1.0",
  "exports": "./main.ts",
  "nodeModulesDir": "none",
  "tasks": {
    "start": "deno run --env-file=../.env --allow-net --allow-env main.ts",
    "dev": "deno run --watch --env-file=../.env --allow-net --allow-env main.ts",
    "check": "deno check main.ts",
    "test": "deno test --allow-net",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "compilerOptions": {
    "strict": true
  }
}
